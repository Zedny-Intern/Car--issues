# ========================================
# Django Settings
# ========================================
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION-use-long-random-string
# Set to True only for local development
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_FRONTEND_API_ENABLED=True

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
DB_NAME=car_diagnosis_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ========================================
# Redis Configuration (for Celery)
# ========================================
REDIS_URL=redis://redis:6379/0

# ========================================
# AI/ML API Keys
# ========================================

# GROQ API Key (Recommended - FREE and FAST!)
# Get your free key from: https://groq.com/
# The system will use GROQ as the primary LLM provider
GROQ_API_KEY=

# OpenAI API Key (Fallback)
# Only needed if GROQ_API_KEY is not provided
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Cohere (Primary for command + vision)
# Get from: https://dashboard.cohere.com/api-keys
USE_COHERE=True
COHERE_API_KEY=
COHERE_COMMAND_MODEL=command-a-03-2025
COHERE_COMMAND_FALLBACK_MODELS=command-a-03-2025,command-r-08-2024,command-r7b-12-2024
COHERE_VISION_MODEL=command-a-vision-07-2025
COHERE_EMBED_MODEL=embed-v4.0
COHERE_EMBED_OUTPUT_DIMENSION=512
COHERE_TEMPERATURE=0.3
COHERE_MAX_TOKENS=1024
COHERE_IMAGE_CHAT_ENABLED=True
COHERE_IMAGE_SCOPE=general
COHERE_IMAGE_MAX_IMAGES_PER_MESSAGE=3

# Lightweight runtime defaults
LLM_PROVIDER_STRATEGY=local_first
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=gpt-oss:120b-cloud
OLLAMA_VISION_MODEL=llava:latest
TEXT_EMBEDDING_BACKEND=cohere
TEXT_EMBEDDING_MODEL=embed-v4.0
TEXT_EMBEDDING_DIMENSION=512
ENABLE_LOCAL_TEXT_EMBEDDINGS=False
ENABLE_LOCAL_CLASSIFIER=False
INSTALL_LOCAL_ML=false
INSTALL_OPTIONAL_LLM_FALLBACKS=false

# ========================================
# CORS Configuration
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ========================================
# RAG Paths
# ========================================
# Local defaults
RAG_DATA_STATIC_DIR=data/static
RAG_DATA_UPLOADS_DIR=data/uploads
RAG_EXTRACTED_IMAGES_DIR=data/extracted_images
RAG_DATA_DIR=rag data
RAG_FAISS_DB_DIR=data/faiss_db
RAG_USE_VISION_ON_INDEX=False
RAG_MAX_IMAGES_PER_DOCUMENT=80
RAG_RETRIEVAL_TIMEOUT_SECONDS=20

# ========================================
# Application Settings
# ========================================

# Time Zone (adjust to your location)
TIME_ZONE=Africa/Cairo

# Language
LANGUAGE_CODE=en-us

# ========================================
# Optional Production Settings
# ========================================

# Email Configuration (for future notifications)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# ========================================
# Security Settings (Production Only)
# ========================================

# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# X_FRAME_OPTIONS=DENY

# ========================================
# Docker Specific (No need to change)
# ========================================

# These are used by docker-compose.yml
# POSTGRES_DB=${DB_NAME}
# POSTGRES_USER=${DB_USER}
# POSTGRES_PASSWORD=${DB_PASSWORD}
